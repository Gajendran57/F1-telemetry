:root {
  --bg: #0d0d11; --panel: #15151e; --panel-2: #1b1b25; --border: #26263a;
  --text: #e8e8ee; --muted: #8b8b9e; --accent: #e10600;
  --teal: #00d2be; --orange: #ff8700;
  --pass: #3bc97a; --warn: #ffb020; --fail: #e10600;
  font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: radial-gradient(circle at 20% -10%, #1a1a26 0%, var(--bg) 55%);
  color: var(--text); min-height: 100vh;
}
.app { max-width: 1280px; margin: 0 auto; padding: 24px 24px 80px; }
.app-loading { display: grid; place-items: center; min-height: 100vh; color: var(--muted); font-size: 15px; }
.app-loading.error { color: var(--fail); }
.topbar { display: flex; align-items: center; justify-content: space-between; padding-bottom: 16px; border-bottom: 1px solid var(--border); }
.brand { display: flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: 0.02em; }
.brand-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); }
.topbar-meta { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; }
.controls { display: flex; gap: 16px; margin-top: 20px; flex-wrap: wrap; }
.control { display: flex; flex-direction: column; gap: 6px; flex: 1; min-width: 220px; }
.control span { font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
.control select { background: var(--panel-2); color: var(--text); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; font-size: 14px; outline: none; }
.control select:focus { border-color: var(--accent); }
.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-top: 20px; }
.stat { background: var(--panel); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; }
.stat-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
.stat-value { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }
.stat-value.positive { color: var(--pass); }
.stat-value.negative { color: var(--fail); }
.stat-sub { font-size: 11px; color: var(--muted); }
.tabs { display: flex; gap: 4px; margin-top: 24px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
.tab { background: none; border: none; color: var(--muted); padding: 12px 18px; font-size: 13px; font-weight: 600; cursor: pointer; letter-spacing: 0.02em; border-bottom: 2px solid transparent; transition: color 0.15s, border-color 0.15s; }
.tab:hover { color: var(--text); }
.tab.active { color: var(--text); border-bottom-color: var(--accent); }
.panel { background: var(--panel); border: 1px solid var(--border); border-top: none; border-radius: 0 0 14px 14px; padding: 24px; }
.panel-inner h2 { margin: 0 0 4px; font-size: 15px; font-weight: 600; }
.panel-head { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.panel-note { margin: 0 0 16px; font-size: 12px; color: var(--muted); }
.chart-tick { fill: var(--muted); font-size: 10px; font-variant-numeric: tabular-nums; }
.chart-axis-label { fill: var(--muted); font-size: 11px; letter-spacing: 0.05em; }
.chart-tooltip { position: absolute; pointer-events: none; background: rgba(21, 21, 30, 0.96); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; font-size: 12px; min-width: 150px; box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45); }
.tooltip-x { color: var(--muted); font-size: 10px; margin-bottom: 4px; letter-spacing: 0.06em; }
.tooltip-row { display: flex; align-items: center; gap: 6px; padding: 2px 0; }
.swatch { width: 8px; height: 8px; border-radius: 2px; flex-shrink: 0; }
.tooltip-label { flex: 1; color: var(--muted); font-size: 11px; }
.tooltip-value { font-variant-numeric: tabular-nums; font-weight: 600; }
.map-wrap { position: relative; display: flex; justify-content: center; }
.track-map { width: 100%; max-width: 720px; height: auto; }
.apex-label { fill: #ffffff; font-size: 11px; font-weight: 700; }
.map-legend { position: absolute; bottom: 0; left: 0; display: flex; gap: 18px; font-size: 11px; color: var(--muted); align-items: center; flex-wrap: wrap; }
.map-legend .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; vertical-align: middle; }
.dot.teal { background: var(--teal); }
.dot.orange { background: var(--orange); }
.map-legend-hint { color: #5a5a72; }
.toggle { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); cursor: pointer; }
.toggle input { accent-color: var(--accent); }
.table-wrap { overflow-x: auto; }
.data-table { width: 100%; border-collapse: collapse; font-size: 12px; }
.data-table th { text-align: left; padding: 10px 12px; color: var(--muted); font-weight: 600; font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; border-bottom: 1px solid var(--border); white-space: nowrap; }
.data-table td { padding: 10px 12px; border-bottom: 1px solid rgba(38, 38, 58, 0.6); font-variant-numeric: tabular-nums; white-space: nowrap; }
.data-table tbody tr:hover { background: rgba(255, 255, 255, 0.02); }
.corner-num { font-weight: 700; color: var(--accent); }
td.strong { font-weight: 600; }
td.pos { color: var(--pass); }
td.neg { color: var(--fail); }
.verifier-summary { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; margin-bottom: 20px; }
.summary-card { background: var(--panel-2); border: 1px solid var(--border); border-radius: 10px; padding: 14px; display: flex; flex-direction: column; gap: 2px; }
.summary-card.pass .summary-value { color: var(--pass); }
.summary-card.warn .summary-value { color: var(--warn); }
.summary-card.fail .summary-value { color: var(--fail); }
.summary-value { font-size: 22px; font-weight: 700; }
.summary-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
.check-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.check-item { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; background: var(--panel-2); border: 1px solid var(--border); border-left: 3px solid var(--border); border-radius: 8px; }
.check-item.pass { border-left-color: var(--pass); }
.check-item.warn { border-left-color: var(--warn); }
.check-item.fail { border-left-color: var(--fail); }
.status-pill { font-size: 9px; font-weight: 700; letter-spacing: 0.08em; padding: 3px 7px; border-radius: 4px; flex-shrink: 0; margin-top: 1px; }
.status-pill.pass { background: rgba(59, 201, 122, 0.15); color: var(--pass); }
.status-pill.warn { background: rgba(255, 176, 32, 0.15); color: var(--warn); }
.status-pill.fail { background: rgba(225, 6, 0, 0.18); color: var(--fail); }
.check-body { display: flex; flex-direction: column; gap: 2px; }
.check-name { font-size: 12.5px; font-weight: 600; }
.check-detail { font-size: 11.5px; color: var(--muted); }
.verifier-footnote { margin-top: 18px; font-size: 11px; color: #5a5a72; }
.verifier-footnote code { color: var(--muted); }
