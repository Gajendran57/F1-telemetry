# Set to "true" to load real telemetry from FastF1 (needs network + first-run download).
# Leave "false" to use the built-in synthetic circuit that matches the frontend mock.
USE_FASTF1=false

# FastF1 session selection (only used when USE_FASTF1=true)
FASTF1_YEAR=2024
FASTF1_GP=Bahrain
FASTF1_SESSION=R
FASTF1_DRIVERS=VER,NOR
FASTF1_CACHE_DIR=.fastf1_cache

# Optional: explicit lap selection, e.g. VER:32,NOR:34
FASTF1_LAPS=

# Optional: path to a FastF1 livetiming recording for best-effort live parsing
FASTF1_LIVE_FILE=

# When false, FastF1 failures are surfaced as errors instead of falling back to mock.
ALLOW_MOCK_FALLBACK=true

# Comma-separated allowed origins for the React dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
